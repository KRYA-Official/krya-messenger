def create_did_video(text):
    """यह फंक्शन D-ID को टेक्स्ट भेजकर वीडियो लिंक प्राप्त करता है।"""
    url = "https://api.d-id.com/talks"
    
    payload = {
        "script": {
            "type": "text",
            "subtitles": "false",
            "provider": {
                "type": "microsoft",
                "voice_id": "hi-IN-MadhurNeural"
            },
            "ssml": "false",
            "input": text
        },
        "config": {
            "fluent": "false",
            "pad_audio": "0.0"
        },
        "source_url": "https://create-images-results.d-id.com/api_docs/assets/noemi.png"
    }
    
    headers = {
        "accept": "application/json",
        "content-type": "application/json",
        "authorization": os.environ.get("D_ID_API_KEY")
    }

    response = requests.post(url, json=payload, headers=headers)
    return response.json()

